# Serveur
PORT=3000
NODE_ENV=development

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=besewu
DB_PASSWORD=change_me
DB_NAME=besewu

# Auth
JWT_SECRET=change_me_in_production_min_32_chars
JWT_EXPIRES_IN=8h

# Anti-fraude
# Écart max (en heures) toléré entre horodatage mobile local et horodatage serveur
# avant de flagger la transaction pour vérification (voir section 1 de la revue critique)
MAX_CLOCK_DRIFT_HOURS=48

# Durée max (en heures) sans synchronisation avant blocage automatique d'un device
MAX_OFFLINE_HOURS=72

# Seuil de litige lors du rapprochement de caisse (en FCFA)
RECONCILIATION_THRESHOLD_FCFA=1000

# Si true, applique les migrations en attente au démarrage de l'app (déconseillé en
# production — préférer `npm run migration:run` en étape séparée et auditée)
MIGRATIONS_RUN_ON_BOOT=false
